# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Auth + Postgres + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — use only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (server-only)
ANTHROPIC_API_KEY=

# Payments / recurring billing (Omise) — server-only secret, public key for the client
NEXT_PUBLIC_OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# LINE Messaging API (notifications / LINE OA)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
