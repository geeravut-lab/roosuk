# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Auth + Postgres + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — use only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=
# Used by scripts/db-migrate.mjs (Supabase Management API). Revoke before launch.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# AI providers (server-only). Gemini must be a billing-enabled key — never the free tier for health data.
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Payments / recurring billing (Omise) — server-only secret, public key for the client
NEXT_PUBLIC_OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# LINE Login (sign-in with LINE)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Messaging API (notifications / LINE OA)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Canonical public URL (optional locally; set on Netlify). Used for OAuth redirects.
NEXT_PUBLIC_SITE_URL=

# Notifications (Phase 1). CRON_SECRET protects /api/cron/notify, which the Netlify
# scheduled function netlify/functions/notify-tick.mts calls every 10 minutes.
CRON_SECRET=
# LINE Official Account (Messaging API) channel access token — must belong to the SAME
# provider as the LINE Login channel so the Login user id works as the push target.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Optional: LIFF app id (cards then open inside LINE), and the OA's add-friend link shown in Settings.
LINE_LIFF_ID=
LINE_OA_ADD_FRIEND_URL=
